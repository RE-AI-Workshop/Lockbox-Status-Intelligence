{
  "servers": {
    "jira": {
      "command": "uvx",
      "args": ["--python", "3.13", "mcp-atlassian"],
      "env": {
        "JIRA_URL": "https://<company>.atlassian.net",
        "JIRA_USERNAME": "<engineer>@company.example",
        "JIRA_API_TOKEN": "REDACTED",
        "CONFLUENCE_URL": "https://<company>.atlassian.net/wiki",
        "CONFLUENCE_USERNAME": "<engineer>@company.example",
        "CONFLUENCE_API_TOKEN": "REDACTED",
        "ENABLED_TOOLS": "jira_get_issue,jira_search,jira_add_comment,jira_update_issue,jira_download_attachments,jira_create_issue,confluence_get_page,confluence_create_page,confluence_update_page,confluence_search,confluence_get_page_children"
      }
    }
  }
}
