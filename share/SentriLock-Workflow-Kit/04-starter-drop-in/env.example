# Copy to .env.local and fill. Never commit the filled file.

# --- API under test ---
BASE_URL=http://localhost:3000
FIXTURE_ADMIN_AUTH=
STANDARD_CALLER_AUTH=

# --- Vault (markdown domain docs) ---
VAULT_PATH=

# --- Jira / Confluence (optional if you only use MCP json) ---
JIRA_URL=https://<company>.atlassian.net
JIRA_USERNAME=
JIRA_API_TOKEN=
JIRA_BASE_URL=https://<company>.atlassian.net
CONFLUENCE_URL=https://<company>.atlassian.net/wiki
CONFLUENCE_USERNAME=
CONFLUENCE_API_TOKEN=

# --- TestRail (optional; prompts skip when TESTRAIL_URL is empty) ---
TESTRAIL_URL=
TESTRAIL_USERNAME=
TESTRAIL_API_KEY=
TESTRAIL_PROJECT_ID=
TESTRAIL_UNIT_SUITE_ID=
TESTRAIL_API_SUITE_ID=
TESTRAIL_REGRESSION_SUITE_ID=
TESTRAIL_SMOKE_SUITE_ID=

# --- UI login for browser verification (optional) ---
DEV_UI_USERNAME=
DEV_UI_PASSWORD=
